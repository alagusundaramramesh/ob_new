PORT=8100
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=outputbooks

# Sent by the React client in the x-api-key header for pre-login endpoints
X_API_KEY=change-me-api-key
JWT_SECRET=change-me-jwt-secret

# Redis is optional. Keep CAN_ENABLE_REDIS=false in common/inc.config.js to run without it
REDIS_URI=redis://127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB_INDEX=1

# E-invoice and e-way bill. EINV_PROVIDER=mock is a TEST provider (nothing is sent to the government, every IRN is marked TEST).
# For real documents use EINV_PROVIDER=taxpro with the ASP id and password given by TaxPro (the GSP the PHP version used).
EINV_PROVIDER=mock
EINV_ASP_ID=
EINV_ASP_PASSWORD=
EINV_IRP=NIC
# Encrypts the GST portal passwords saved in the database. 64 hex characters, for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it a key is derived from JWT_SECRET. If the key changes, the passwords must be typed again.
SECRET_KEY=

# SMTP (forgot password and emailing invoices). Without SMTP_HOST the email button answers with a clear error
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


#MYSQL (optional, but recommended for production). Without MYSQL_HOST the app will run in memory only
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=outputbooks
